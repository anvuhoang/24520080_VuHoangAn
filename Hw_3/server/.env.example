# server/.env.example — a template with NO secrets. Copy it to `.env` (which git ignores) and fill it in.
# `npm start` reads `.env` when it exists (Node 22.9 or newer).

# REQUIRED. The connection string of your MongoDB (local or Atlas). The server refuses to start without it.
# Never write the real string in the source code or in this file.
MONGODB_URI=

# Port the API listens on (default 3003)
PORT=3003

# The ONE browser origin that may call the API (CORS). Never `*`.
# Optional while developing (default http://localhost:5173); REQUIRED when NODE_ENV=production.
CLIENT_ORIGIN=http://localhost:5173
