# server/.env.example — a template with NO secrets. Copy it to `.env` (which git ignores) and change the values.
# `npm start` reads `.env` when it exists (Node 22.9 or newer); without it the defaults below are used.

# Port the API listens on
PORT=3001

# The ONE browser origin that may call the API (CORS). Never `*`.
CLIENT_ORIGIN=http://localhost:5173

# Not used by this exercise (the store is in memory). The Mongoose 8 homework will read the connection string
# from here and must refuse to start without it; never write the real string in the source or in this file.
# MONGODB_URI=
